PORT=3000
# Job discovery: rolling posting-date window, sort order, and background refresh schedule
JOB_POSTED_WITHIN_DAYS=7
JOB_SORT=newest
JOB_REFRESH_INTERVAL_HOURS=6
# Optional job source: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Set to the public HTTPS origin in production, e.g. https://jobs.example.com
PUBLIC_BASE_URL=http://localhost:3000
# Amazon Cognito (required for registration/login)
AWS_REGION=ap-south-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
# Cognito domain prefix only, without https://; e.g. your-prefix.auth.ap-south-1.amazoncognito.com
COGNITO_DOMAIN=
# DynamoDB table with partition key userId (String)
DYNAMODB_USERS_TABLE=IndiaJobHubUsers
